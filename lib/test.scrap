-- test: the cases of a test scrap, which `scrap test` runs. A test scrap's
-- value groups cases in records, by label, and in lists, by index, as in
-- `{ insert = { keeps-order = test.eq (to-list t) [1, 2, 3] } }`.
--
-- Each function makes one kind of case. They are open enums, so cases of
-- different kinds can share a list.

{ eq
, float-eq
, pass = #pass
, fail
}

-- Passes if got and want are the same value, which must hold no functions.
; eq : a => r => a -> a -> [#eq { got : a, want : a }, ..r]
  = got -> want -> #eq { got, want }

-- Passes if got is no more than within from want.
; float-eq : r => float -> float -> float -> [#float-eq { got : float, want : float, within : float }, ..r]
  = within -> got -> want -> #float-eq { got, want, within }

-- Fails, saying why.
; fail : r => text -> [#fail text, ..r]
  = why -> #fail why
