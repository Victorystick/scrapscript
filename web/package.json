{
  "name": "scrapscript-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:wasm && vite dev",
    "build": "pnpm build:wasm && vite build",
    "build:wasm": "pnpm --filter @scrapscript/web build",
    "preview": "pnpm build && vite preview",
    "build:scrap": "go build -o build/scrap ../cmd/scrap",
    "test": "pnpm build:wasm && pnpm build:scrap && vitest run"
  },
  "dependencies": {
    "@scrapscript/web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "vite": "^6.3.5",
    "vitest": "3.2.4"
  }
}
